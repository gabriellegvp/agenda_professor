import json
from datetime import datetime, timedelta
import os

AGENDA_FILE = "agenda.json"

def carregar_agenda():
    if os.path.exists(AGENDA_FILE):
        with open(AGENDA_FILE, "r") as arquivo:
            return json.load(arquivo)
    return {}

def salvar_agenda(agenda):
    with open(AGENDA_FILE, "w") as arquivo:
        json.dump(agenda, arquivo, indent=4)
    print("Agenda salva com sucesso!")

def validar_data(dia, mes, ano):
    try:
        datetime.strptime(f"{dia} {mes} {ano}", "%d %B %Y")
        return True
    except ValueError:
        return False

def validar_horario(horario):
    try:
        datetime.strptime(horario, "%Hh")
        return True
    except ValueError:
        return False

def adicionar_atividade(agenda, dia, mes, ano, hora, atividade):
    if not validar_data(dia, mes, ano):
        print("Data inválida. Tente novamente.")
        return
    if not validar_horario(hora):
        print("Horário inválido. Use o formato '12h'.")
        return

    if ano not in agenda:
        agenda[ano] = {}
    if mes not in agenda[ano]:
        agenda[ano][mes] = {}
    if dia not in agenda[ano][mes]:
        agenda[ano][mes][dia] = []
    agenda[ano][mes][dia].append((hora, atividade))
    print("Atividade adicionada com sucesso!")
    salvar_agenda(agenda)

def exibir_atividades_dia(agenda, dia, mes, ano):
    if ano in agenda and mes in agenda[ano] and dia in agenda[ano][mes]:
        atividades = agenda[ano][mes][dia]
        atividades.sort()
        return "\n".join([f"{hora}: {atividade}" for hora, atividade in atividades])
    return "Agenda livre"

def exibir_atividades_semana(agenda, semana, mes, ano):
    inicio = (semana - 1) * 7 + 1
    fim = min(inicio + 6, 31)
    atividades_semana = []
    for dia in range(inicio, fim + 1):
        dia_str = str(dia)
        atividades = exibir_atividades_dia(agenda, dia_str, mes, ano)
        atividades_semana.append(f"Dia {dia_str}:\n{atividades}")
    return "\n\n".join(atividades_semana)

def limpar_dia(agenda, dia, mes, ano):
    if ano in agenda and mes in agenda[ano] and dia in agenda[ano][mes]:
        del agenda[ano][mes][dia]
        print(f"Todas as atividades do dia {dia} de {mes} de {ano} foram apagadas.")
        salvar_agenda(agenda)
    else:
        print(f"Não há atividades no dia {dia} de {mes} de {ano}.")

def limpar_mes(agenda, mes, ano):
    if ano in agenda and mes in agenda[ano]:
        del agenda[ano][mes]
        print(f"Todas as atividades do mês {mes} de {ano} foram apagadas.")
        salvar_agenda(agenda)
    else:
        print(f"Não há atividades no mês {mes} de {ano}.")

def limpar_semana(agenda, semana, mes, ano):
    inicio = (semana - 1) * 7 + 1
    fim = min(inicio + 6, 31)
    if ano in agenda and mes in agenda[ano]:
        for dia in range(inicio, fim + 1):
            dia_str = str(dia)
            if dia_str in agenda[ano][mes]:
                del agenda[ano][mes][dia_str]
        if not agenda[ano][mes]:
            del agenda[ano][mes]
        print(f"Atividades da semana {semana} em {mes} de {ano} foram apagadas.")
        salvar_agenda(agenda)
    else:
        print(f"Não há atividades no mês {mes} de {ano} para a semana {semana}.")

def verificar_notificacoes(agenda):
    agora = datetime.now()
    proximas_atividades = []
    for ano, meses in agenda.items():
        for mes, dias in meses.items():
            for dia, atividades in dias.items():
                for hora, atividade in atividades:
                    try:
                        data_atividade = datetime.strptime(f"{dia} {mes} {ano} {hora}", "%d %B %Y %Hh")
                        if agora <= data_atividade <= agora + timedelta(minutes=10):
                            proximas_atividades.append((data_atividade, atividade))
                    except ValueError:
                        pass
    if proximas_atividades:
        print("\n--- NOTIFICAÇÕES ---")
        for data, atividade in proximas_atividades:
            print(f"Atividade próxima às {data.strftime('%H:%M')} - {atividade}")
        print("----------------------")
    else:
        print("Nenhuma atividade próxima.")

def interagir():
    agenda = carregar_agenda()
    while True:
        print("\n--- AGENDA INTERATIVA ---")
        print("1. Adicionar atividade")
        print("2. Consultar atividades de um dia")
        print("3. Consultar atividades de uma semana")
        print("4. Limpar atividades de um dia")
        print("5. Limpar atividades de um mês")
        print("6. Limpar atividades de uma semana")
        print("7. Verificar notificações")
        print("8. Sair")
        opcao = input("Escolha uma opção: ")

        if opcao == '1':
            ano = input("Informe o ano (ex: 2023): ")
            mes = input("Informe o mês (ex: Janeiro): ")
            dia = input("Informe o dia (1-31): ")
            hora = input("Informe o horário (ex: 12h): ")
            atividade = input("Descreva a atividade: ")
            adicionar_atividade(agenda, dia, mes, ano, hora, atividade)

        elif opcao == '2':
            ano = input("Informe o ano (ex: 2023): ")
            mes = input("Informe o mês (ex: Janeiro): ")
            dia = input("Informe o dia (1-31): ")
            atividades = exibir_atividades_dia(agenda, dia, mes, ano)
            print(f"Atividades para o dia {dia} de {mes} de {ano}:\n{atividades}")

        elif opcao == '3':
            ano = input("Informe o ano (ex: 2023): ")
            mes = input("Informe o mês (ex: Janeiro): ")
            try:
                semana = int(input("Informe o número da semana (1-5): "))
                atividades_semana = exibir_atividades_semana(agenda, semana, mes, ano)
                print(f"Atividades para a semana {semana} de {mes} de {ano}:\n{atividades_semana}")
            except ValueError:
                print("Número da semana inválido. Tente novamente.")

        elif opcao == '4':
            ano = input("Informe o ano (ex: 2023): ")
            mes = input("Informe o mês (ex: Janeiro): ")
            dia = input("Informe o dia (1-31): ")
            limpar_dia(agenda, dia, mes, ano)

        elif opcao == '5':
            ano = input("Informe o ano (ex: 2023): ")
            mes = input("Informe o mês (ex: Janeiro): ")
            limpar_mes(agenda, mes, ano)

        elif opcao == '6':
            ano = input("Informe o ano (ex: 2023): ")
            mes = input("Informe o mês (ex: Janeiro): ")
            try:
                semana = int(input("Informe o número da semana (1-5): "))
                limpar_semana(agenda, semana, mes, ano)
            except ValueError:
                print("Número da semana inválido. Tente novamente.")

        elif opcao == '7':
            verificar_notificacoes(agenda)

        elif opcao == '8':
            print("Saindo...")
            salvar_agenda(agenda)
            break

        else:
            print("Opção inválida. Tente novamente.")

if __name__ == "__main__":
    interagir()